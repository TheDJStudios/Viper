<idea-plugin>
    <id>dev.viper.idea</id>
    <name>Viper Language Support</name>
    <vendor email="devnull@example.com">TheDJStudios</vendor>
    <description><![CDATA[
        Basic language support for Viper files in JetBrains IDEs.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Viper"
                implementationClass="dev.viper.idea.ViperFileType"
                fieldName="INSTANCE"
                language="Viper"
                extensions="vp"/>
        <lang.syntaxHighlighterFactory
                language="Viper"
                implementationClass="dev.viper.idea.ViperSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="Viper"
                implementationClass="dev.viper.idea.ViperParserDefinition"/>
        <lang.commenter
                language="Viper"
                implementationClass="dev.viper.idea.ViperCommenter"/>
        <lang.braceMatcher
                language="Viper"
                implementationClass="dev.viper.idea.ViperBraceMatcher"/>
        <completion.contributor
                language="Viper"
                implementationClass="dev.viper.idea.ViperCompletionContributor"/>
        <colorSettingsPage implementation="dev.viper.idea.ViperColorSettingsPage"/>
        <enterHandlerDelegate implementation="dev.viper.idea.ViperEnterHandlerDelegate"/>
        <postStartupActivity implementation="dev.viper.idea.ViperStartupActivity"/>
        <notificationGroup id="Viper Notifications" displayType="BALLOON" isLogByDefault="true"/>
        <configurationType implementation="dev.viper.idea.ViperRunConfigurationType"/>
        <runConfigurationProducer implementation="dev.viper.idea.ViperRunConfigurationProducer"/>
    </extensions>

    <actions>
        <action id="Viper.RunFile"
                class="dev.viper.idea.ViperRunFileAction"
                text="Run Viper File"
                description="Run the selected Viper file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
        <action id="Viper.CompileFile"
                class="dev.viper.idea.ViperCompileFileAction"
                text="Compile Viper File"
                description="Compile the selected Viper file">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
