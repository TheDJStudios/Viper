import "secondary.vp";

int localValue() {
    return 4 * 5;
}

$ number: int = 5 * 3;
$ ready: bool = true;
$ missing: none = none;
$ name: str = "";

print("Viper file successfully ran");
print(number);
print(2 + 3 * 4);
print((2 + 3) * 4);
print(missing);
print(localValue());
print(importedValue());
showImportedMessage();

if (ready and number == 15) {
    print("if branch");
} else if (number > 20) {
    print("else if branch");
} else {
    print("else branch");
}
print("Name?");
$name = collect(">> ");

if (name != "") {
    print(#"Hello [name]");

}

if (ready and number == 10) {
    print("Testing the new jetbrains plugin");
} else {
    print("Failed to meet conditions");
}
